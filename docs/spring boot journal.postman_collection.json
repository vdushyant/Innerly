{
  "info": {
    "_postman_id": "55b0b477-f060-4889-a051-fc1c1f5d0b92",
    "name": "Innerly API",
    "description": "Requests for the Innerly journal backend. Configure the collection variables before use.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{access_token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "user_name", "value": "innerly-user" },
    { "key": "password", "value": "change-me" },
    { "key": "access_token", "value": "" },
    { "key": "entry_id", "value": "" }
  ],
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/public/health-check",
            "auth": { "type": "noauth" }
          },
          "response": []
        },
        {
          "name": "Sign up",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"{{user_name}}\",\n  \"password\": \"{{password}}\",\n  \"email\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/public/signup"
          },
          "response": []
        },
        {
          "name": "Log in (saves token)",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"{{user_name}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/public/login"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "if (pm.response.code === 200) {",
                "  pm.collectionVariables.set('access_token', pm.response.json().token);",
                "}"
              ]
            }
          }],
          "response": []
        }
      ]
    },
    {
      "name": "Journal",
      "item": [
        {
          "name": "List my pages",
          "request": { "method": "GET", "url": "{{base_url}}/journal" },
          "response": []
        },
        {
          "name": "Create page (saves ID)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"A page from Postman\",\n  \"content\": \"Write your journal entry here.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/journal"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "if (pm.response.code === 200) {",
                "  pm.collectionVariables.set('entry_id', String(pm.response.json().id));",
                "}"
              ]
            }
          }],
          "response": []
        },
        {
          "name": "Get page by ID",
          "request": { "method": "GET", "url": "{{base_url}}/journal/id/{{entry_id}}" },
          "response": []
        },
        {
          "name": "Update page",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated page title\",\n  \"content\": \"Updated journal text.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/journal/id/{{entry_id}}"
          },
          "response": []
        },
        {
          "name": "Delete page",
          "request": { "method": "DELETE", "url": "{{base_url}}/journal/id/{{entry_id}}" },
          "response": []
        }
      ]
    },
    {
      "name": "User",
      "item": [
        {
          "name": "Current user",
          "request": { "method": "GET", "url": "{{base_url}}/user/me" },
          "response": []
        },
        {
          "name": "Weather greeting",
          "request": { "method": "GET", "url": "{{base_url}}/user" },
          "response": []
        },
        {
          "name": "Update account",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"{{user_name}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/user"
          },
          "response": []
        },
        {
          "name": "Delete account",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/user"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "List users",
          "request": { "method": "GET", "url": "{{base_url}}/admin/all-users" },
          "response": []
        },
        {
          "name": "Create admin user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"admin-user\",\n  \"password\": \"change-me\",\n  \"email\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/admin/create-admin-user"
          },
          "response": []
        },
        {
          "name": "Reload application cache",
          "request": { "method": "GET", "url": "{{base_url}}/admin/clear-app-cache" },
          "response": []
        }
      ]
    }
  ]
}
